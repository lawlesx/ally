# Copy to .env and fill in. Never commit .env.
ELEVENLABS_API_KEY=

# Used after each call to update Ally's memory (memory.md). Without it she still
# talks, but remembers nothing between calls.
ANTHROPIC_API_KEY=

# Locks the app: the page asks for this once per device. Required before Ally
# can be reached from anywhere but this computer.
ALLY_PASSCODE=

# Hosting only (e.g. Railway):
# ALLY_AGENT_ID=        the agent id from .ally/agent.json
# ALLY_DATA_DIR=/data   a persistent volume for memory.md
# TZ=Asia/Kolkata       your time zone, so dates in her memory are right

# Optional overrides (defaults live in scripts/setup-agent.mjs)
# ALLY_VOICE_ID=
# ALLY_LLM=
# ALLY_TTS_MODEL=
# ALLY_MEMORY_MODEL=
# ALLY_LOOKUP_MODEL=
# ALLY_RECALL_MODEL=
# PORT=5173
